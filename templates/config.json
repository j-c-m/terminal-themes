{
  "shell": {
    "template": "shell.sh",
    "directory": "shell",
    "filename": "{{theme-slug}}.sh"
  },
  "alacritty": {
    "template": "alacritty.toml",
    "directory": "alacritty",
    "filename": "{{theme-slug}}.toml"
  },
  "ghostty": {
    "template": "ghostty",
    "directory": "ghostty",
    "filename": "{{theme-slug}}"
  },
  "wezterm": {
    "template": "wezterm.toml",
    "directory": "wezterm",
    "filename": "{{theme-slug}}.toml"
  },
  "kitty": {
    "template": "kitty.conf",
    "directory": "kitty",
    "filename": "{{theme-slug}}.conf"
  },
  "iterm": {
    "template": [ "iterm.itermcolors", "iterm.itermcolors" ],
    "directory": "itermcolors",
    "filename": "{{theme-slug}}.itermcolors",
    "dual_mode": true
  },
  "debug": {
    "template": [ "debug.txt", "debug-dual.txt" ],
    "directory": "debug-txt",
    "filename": "{{theme-slug}}.txt",
    "dual_mode": true
  },
  "json": {
    "template": "json.json",
    "directory": "json",
    "filename": "{{theme-slug}}.json"
  },
  "iterm2-color-yml": {
    "template": "iterm2-color.yml",
    "directory": "iterm2-color-yml",
    "filename": "{{theme-slug}}.yml"
  }
}
